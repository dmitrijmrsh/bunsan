<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dmitrymrsh.bunsan</groupId>
        <artifactId>spring-cloud-bunsan</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>load-tests</artifactId>
    <name>Load Tests (Gatling)</name>

    <properties>
        <!-- По умолчанию тесты пропускаются при mvn install/verify.
             Переопределить: -Dgatling.skip=false -->
        <gatling.skip>true</gatling.skip>
    </properties>
    <description>
        Gatling-симуляции (Java DSL) для сравнения пяти стратегий балансировки:
        RoundRobin (baseline), Random (baseline), WeightedResponseTime, LeastConnections, Adaptive.
        Сценарий: 2 мин прогрев → 5 мин стабильная нагрузка → 1 мин инъекция деградации → 5 мин наблюдение.
        Результаты экспортируются в CSV в load-tests/results/.
    </description>

    <!-- load-tests не является Spring Boot приложением — просто Maven-модуль для Gatling -->
    <dependencies>
        <!-- Gatling Java DSL: ядро + HTTP -->
        <dependency>
            <groupId>io.gatling</groupId>
            <artifactId>gatling-core-java</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling</groupId>
            <artifactId>gatling-http-java</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Gatling App (runtime, charts) -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/java</testSourceDirectory>

        <plugins>
            <!-- Стандартный java-компилятор.
                 Симуляции компилируются для Java 11, чтобы Gatling (старая версия ASM)
                 мог читать class-файлы при запуске на Java 25. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!--
                Запуск симуляций (только явно, не привязан к lifecycle):
                  mvn gatling:test -pl load-tests \
                    -Dgatling.simulationClass=com.dmitrymrsh.bunsan.simulation.WeightedResponseTimeSimulation \
                    -Dgatling.baseUrl=http://localhost:8080
            -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-plugin.version}</version>
                <configuration>
                    <resultsFolder>${project.basedir}/results</resultsFolder>
                    <!-- Не запускать автоматически при mvn install / verify -->
                    <skip>${gatling.skip}</skip>
                    <!-- Открываем пакеты Java для Gatling (требуется на Java 17+) -->
                    <jvmArgs>
                        <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.nio=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.util.concurrent=ALL-UNNAMED</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
