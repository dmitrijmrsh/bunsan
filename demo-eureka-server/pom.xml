<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dmitrymrsh.bunsan</groupId>
        <artifactId>spring-cloud-bunsan</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>demo-eureka-server</artifactId>
    <name>Demo Eureka Server</name>
    <description>
        Eureka Server с подключённым bunsan-spring-boot-starter.
        Стартер регистрирует OverloadInstanceFilter, который фильтрует
        перегруженные инстансы (статус OUT_OF_SERVICE) из ответов реестра.
    </description>

    <dependencies>
        <!-- Наш стартер — активирует OverloadInstanceFilter на Eureka Server -->
        <dependency>
            <groupId>com.dmitrymrsh.bunsan</groupId>
            <artifactId>bunsan-spring-boot-starter</artifactId>
        </dependency>

        <!-- Eureka Server -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>

        <!-- Actuator + Prometheus для мониторинга самого Eureka Server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
